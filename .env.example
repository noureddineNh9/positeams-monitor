# Uptime Kuma Docker image tag
UPTIME_KUMA_VERSION=2

# Keep the dashboard private by default. Use a reverse proxy or SSH tunnel.
UPTIME_KUMA_BIND_ADDRESS=127.0.0.1
UPTIME_KUMA_PORT=3001

# Persistent Docker volume name
UPTIME_KUMA_VOLUME_NAME=uptime-kuma-data

# Dashboard and notification timezone
TZ=Africa/Casablanca
