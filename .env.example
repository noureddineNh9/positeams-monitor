# MySQL TCP endpoint
MYSQL_HOST=your-database-host
MYSQL_PORT=25060

# Monitoring (seconds)
CHECK_INTERVAL=300
CHECK_TIMEOUT=5
RETRY_DELAY=10

# Daily file logging
LOG_DIR=/logs
LOG_RETENTION_DAYS=30

# Mailgun API
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
MAILGUN_REGION=US

# Email recipients
FROM_EMAIL=monitor@mg.example.com
ALERT_EMAIL=you@example.com
